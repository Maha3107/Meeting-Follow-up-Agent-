# LLM providers (free tiers)
GROQ_API_KEY=your_groq_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here

# Which model to use per node - "groq" or "gemini"
SUMMARIZE_MODEL=gemini
EXTRACT_MODEL=groq
CLASSIFY_MODEL=groq

# Email (Gmail SMTP + App Password)
GMAIL_ADDRESS=your_email@gmail.com
GMAIL_APP_PASSWORD=your_16_char_app_password

# Notion (task creation)
NOTION_TOKEN=your_notion_integration_token
NOTION_DATABASE_ID=your_notion_database_id

# Storage
DATABASE_PATH=meetings.db

# Attendee (self-hosted meeting bot)
ATTENDEE_BASE_URL=http://localhost:8000
ATTENDEE_API_KEY=your_attendee_api_key_here
ATTENDEE_POLL_SECONDS=30

# Google Calendar: no env vars. Put credentials.json (from Google Cloud Console)
# in this folder. token.json is created on first login.
